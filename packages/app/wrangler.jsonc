{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nansuka",
  "main": "./src/server.ts",
  "compatibility_date": "2024-11-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/1705822b8e7fa963d60ac9855493cbfb/nansuka-proxy/anthropic"
  },
  // シークレットの設定:
  //   wrangler secret put CF_AIG_TOKEN
  //   wrangler secret put CF_AIG_TOKEN --env staging
  // AnthropicのAPIキーはAI Gatewayのダッシュボードで設定
  "env": {
    "staging": {
      "name": "nansuka-staging",
      "vars": {
        "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/1705822b8e7fa963d60ac9855493cbfb/nansuka-proxy/anthropic"
      }
    }
  }
}
